function alogin() {
    # Extract values inside brackets from ~/.saml2aws
    local options=()
    while IFS= read -r line; do
        options+=("$line")
    done < <(awk -F'[][]' '{for (i=2; i<=NF; i+=2) print $i}' ~/.saml2aws)

    # Check if options array is empty
    if [[ ${#options[@]} -eq 0 ]]; then
        echo "No saml2aws profiles found"
        return 1
    fi

    echo "Select an option:"
    select choice in "${options[@]}"; do
        if [[ -n "$choice" ]]; then
            echo "Logging into: $choice"
            echo "$choice" > ~/.aws/profileChoice
            saml2aws login --idp-account="$choice"
            
            # If logging into adfs-aws77, also create ed-prod-eu profile
            if [[ "$choice" == "adfs-aws77" ]]; then
                echo "Creating additional profile: ed-prod-eu"
                local creds_file="$HOME/.aws/credentials"
                if [[ -f "$creds_file" ]]; then
                    # Extract credentials from adfs-aws77 profile using awk
                    local access_key_id
                    local secret_access_key
                    local session_token
                    
                    # Use awk to extract values between [adfs-aws77] and next [section] or end of file
                    access_key_id=$(awk '/^[adfs-aws77]/ {flag=1; next} /^[/ {flag=0} flag && /^aws_access_key_id/ {print $3; exit}' "$creds_file")
                    secret_access_key=$(awk '/^[adfs-aws77]/ {flag=1; next} /^[/ {flag=0} flag && /^aws_secret_access_key/ {print $3; exit}' "$creds_file")
                    session_token=$(awk '/^[adfs-aws77]/ {flag=1; next} /^[/ {flag=0} flag && /^aws_session_token/ {print $3; exit}' "$creds_file")
                    
                    if [[ -n "$access_key_id" && -n "$secret_access_key" ]]; then
                        # Create temporary file with updated credentials
                        local temp_file
                        temp_file=$(mktemp)
                        
                        # Copy file, removing existing ed-prod-eu section if present
                        awk '
                            /^[ed-prod-eu]/ {skip=1; next}
                            skip && /^[/ {skip=0}
                            !skip {print}
                        ' "$creds_file" > "$temp_file"
                        
                        # Add ed-prod-eu profile at the end
                        {
                            echo "[ed-prod-eu]"
                            echo "aws_access_key_id = $access_key_id"
                            echo "aws_secret_access_key = $secret_access_key"
                            [[ -n "$session_token" ]] && echo "aws_session_token = $session_token"
                        } >> "$temp_file"
                        
                        # Replace original file
                        mv "$temp_file" "$creds_file"
                        echo "Profile ed-prod-eu created successfully"
                    else
                        echo "Warning: Could not extract credentials from adfs-aws77 profile"
                    fi
                fi
            fi
            
            return 0
        else
            echo "Invalid selection, try again."
        fi
    done
}

function aws() {
  local profileFile="$HOME/.aws/profileChoice"

  # Check if profile file is empty
  if [[ ! -s "$profileFile" || $(wc -c < "$profileFile") -eq 0 ]]; then
      echo "Error: $profileFile is empty. Exiting"
      exit 0
  fi
  myprofile=$(cat $profileFile)
  command aws --profile $myprofile "$@"
}

function asregion() {
    local profileFile="$HOME/.aws/profileChoice"
    local config_file="$HOME/aws_regions.json"
    # Check if profile file exists and is not empty
    if [[ ! -s "$profileFile" ]]; then
        echo "Error: $profileFile is empty or does not exist. Exiting."
        return 1
    fi

    # Read the AWS profile from the file
    local aws_profile
    aws_profile=$(cat "$profileFile")
    local environments
    environments=$(jq -r --arg acc "$aws_profile" '
    if .[$acc] then .[$acc] | to_entries[] | "(.key) (.value)" else empty end ' "$config_file")
    if [[ -z "$environments" ]]; then
        echo "No environments found for account: $aws_profile"
        return 1
      fi

      echo "Available environments for '$aws_profile':"
      local i=1
      local options=()
      while IFS= read -r line; do
        options+=("$line")
        echo "$i) $line"
        ((i++))
      done <<< "$environments"

      read -p "Select environment [1-${#options[@]}]: " selection
      if ! [[ "$selection" =~ ^[0-9]+$ ]] || (( selection < 1 || selection > ${#options[@]} )); then
        echo "Invalid selection."
        return 1
      fi

      selected="${options[selection-1]}"
      echo "selected environment: $selected"
      env_name="$(echo $selected | awk '{ print $1 }')"
      region="$(echo $selected | awk '{ print $2 }')"
      k8sconfig=$env_name
      echo "$env_name" > "$HOME/.aws/currentEnvironment"

    # Set the region for the selected profile
    aws configure set region "$region" --profile "$aws_profile"
    echo "AWS region set to $region for profile $aws_profile."
    if [[ ! -f "$HOME/kube/$k8sconfig" ]]; then
      echo "Creating kubeconfig file $k8sconfig"
      touch "$HOME/.kube/$k8sconfig"
    fi
    skconfig $k8sconfig
    gkconfig

}