/target
WSL/target/*
dist/*
WSL/dist/*

# Claude Code settings are per-developer (machine-specific paths, usernames).
# Keep them out of git — settings.local.json is already ignored by default.
.claude/settings.json
.claude/settings.local.json

# The escalation notifier design describes personal infrastructure — a private
# phone, a personal mailbox and a home Raspberry Pi — not anything the app
# ships. It stays local. The glob covers the matching plan document too, since
# the spec → plan workflow generates one under docs/superpowers/plans/.
WSL/docs/superpowers/**/*escalation-notifier*

WSL/docs/superpowers/specs/2026-08-14-reaper-auto-remediation-design.md
WSL/docs/superpowers/plans/2026-08-17-reaper-auto-remediation.md

# Design docs are working notes for the spec -> plan workflow, not something
# the app ships. The whole tree stays local from here on. Files already
# tracked above this line stay tracked -- a .gitignore rule does not untrack
# anything, and CLAUDE.md refers to some of them by name.
WSL/docs/
